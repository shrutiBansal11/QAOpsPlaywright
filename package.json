{
  "name": "playwrightproject",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test:ui": "PLAYWRIGHT_HTML_REPORT=reports/UI playwright test --project=UI",
    "test:ui-api": "PLAYWRIGHT_HTML_REPORT=reports/UI_API playwright test --project=UI_API",
    "test:e2e": "PLAYWRIGHT_HTML_REPORT=reports/e2e playwright test --project=e2e",
    "test:misc": "PLAYWRIGHT_HTML_REPORT=reports/Miscellaneous playwright test --project=Miscellaneous",
    "report:ui": "playwright show-report reports/UI",
    "report:ui-api": "playwright show-report reports/UI_API",
    "report:e2e": "playwright show-report reports/e2e",
    "report:misc": "playwright show-report reports/Miscellaneous",
    "test": "npx playwright test tests/WebAPI.spec.js",
    "SmokeTest": "npx playwright test --grep @Smoke",
    "CucumberCheckout": "npx cucumber-js --tags '@checkout' --retry 1 --exit --format html:cucumber-report.html"
  },
  "keywords": [],
