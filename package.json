    "@playwright/test": "^1.61.0",
    "@types/node": "^22.20.4",
    "allure": "^3.20.0",
    "allure-cucumberjs": "^3.13.0",
    "allure-playwright": "^3.12.1",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dayjs": "^1.11.21",
    "exceljs": "^4.4.0"
  }
